{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "security-audit",
          "informationUri": "https://owasp.org/www-project-application-security-verification-standard/",
          "rules": [
            {
              "id": "SEC-017",
              "name": "IP de origem lido do primeiro item do X-Forwarded-For, controlado pelo cliente",
              "shortDescription": {
                "text": "IP de origem lido do primeiro item do X-Forwarded-For, controlado pelo cliente"
              },
              "fullDescription": {
                "text": "Se o proxy do Render acrescenta o IP real ao X-Forwarded-For enviado pelo cliente (em vez de sobrescrever), o cliente manda 'X-Forwarded-For: <IP aleatório>' a cada tentativa: o limite por IP (20 falhas/15 min) nunca dispara e log_operacao grava o IP forjado."
              },
              "help": {
                "text": "Conferir no Render (enviar X-Forwarded-For forjado e ver o ip gravado em /logs). Se for acrescentado, usar o último item do cabeçalho (o que o proxy do Render adiciona) num middleware próprio, ou restringir FORWARDED_ALLOW_IPS à rede do proxy."
              },
              "properties": {
                "security-severity": "3.0",
                "tags": [
                  "security",
                  "CWE-348",
                  "API4:2023",
                  "STRIDE:S",
                  "STRIDE:R"
                ],
                "pillars": [
                  "Não-repúdio",
                  "Disponibilidade"
                ],
                "principles": [
                  "Fail secure",
                  "Defesa em profundidade"
                ]
              }
            },
            {
              "id": "SEC-018",
              "name": "Gestor lê toda a trilha de auditoria, com IP e e-mails de todas as contas",
              "shortDescription": {
                "text": "Gestor lê toda a trilha de auditoria, com IP e e-mails de todas as contas"
              },
              "fullDescription": {
                "text": "Um gestor chama GET /logs?acao=login e obtém IP e horário de login de todos os usuários, inclusive dos admins, e os e-mails digitados nos logins falhos."
              },
              "help": {
                "text": "Restringir GET /logs ao admin, ou para o gestor omitir ip/detalhes e eventos de contas admin/gestor."
              },
              "properties": {
                "security-severity": "3.0",
                "tags": [
                  "security",
                  "CWE-359",
                  "API3:2023",
                  "STRIDE:I"
                ],
                "pillars": [
                  "Confidencialidade"
                ],
                "principles": [
                  "Menor privilégio"
                ]
              }
            },
            {
              "id": "SEC-019",
              "name": "Login falho grava o texto digitado no campo e-mail",
              "shortDescription": {
                "text": "Login falho grava o texto digitado no campo e-mail"
              },
              "fullDescription": {
                "text": "Usuário digita a senha no campo de e-mail por engano; o texto fica em log_operacao e aparece em GET /logs."
              },
              "help": {
                "text": "Gravar usuario_id quando a conta existir e, quando não existir, só um hash ou o domínio do e-mail."
              },
              "properties": {
                "security-severity": "0.0",
                "tags": [
                  "security",
                  "CWE-532",
                  "A09:2021",
                  "STRIDE:I"
                ],
                "pillars": [
                  "Confidencialidade"
                ],
                "principles": [
                  "Minimização (LGPD)"
                ]
              }
            },
            {
              "id": "SEC-020",
              "name": "Filtros de data inválidos em /logs são ignorados em silêncio",
              "shortDescription": {
                "text": "Filtros de data inválidos em /logs são ignorados em silêncio"
              },
              "fullDescription": {
                "text": "de=31/10/2026 (formato inválido) devolve logs de todo o período, sem aviso, a quem pediu um recorte."
              },
              "help": {
                "text": "Responder 422 para data inválida (declarar os parâmetros como date/datetime)."
              },
              "properties": {
                "security-severity": "0.0",
                "tags": [
                  "security",
                  "CWE-390",
                  "—",
                  "STRIDE:I"
                ],
                "pillars": [
                  "Integridade"
                ],
                "principles": [
                  "Fail secure"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SEC-017",
          "level": "note",
          "message": {
            "text": "IP de origem lido do primeiro item do X-Forwarded-For, controlado pelo cliente. Contorna a camada por IP do limite de tentativas (o limite por conta continua) e torna o IP da trilha de auditoria (SEC-010) inconfiável. Baixa porque depende do comportamento do proxy, não verificado; vira Média se confirmado."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "render.yaml"
                },
                "region": {
                  "startLine": 18
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/rate_limit.py"
                },
                "region": {
                  "startLine": 74
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/auditoria.py"
                },
                "region": {
                  "startLine": 41
                }
              }
            }
          ],
          "properties": {
            "source": [
              "claude"
            ]
          }
        },
        {
          "ruleId": "SEC-018",
          "level": "note",
          "message": {
            "text": "Gestor lê toda a trilha de auditoria, com IP e e-mails de todas as contas. Exposição de dados pessoais (IP, padrão de acesso) além da necessidade do perfil; o backlog do produto define a auditoria como atribuição do admin. Exige conta de gestor."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/routers/dashboard.py"
                },
                "region": {
                  "startLine": 85
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/routers/dashboard.py"
                },
                "region": {
                  "startLine": 118
                }
              }
            }
          ],
          "properties": {
            "source": [
              "claude"
            ]
          }
        },
        {
          "ruleId": "SEC-019",
          "level": "note",
          "message": {
            "text": "Login falho grava o texto digitado no campo e-mail. Dado sem finalidade guardado por até LOG_RETENCAO_DIAS. Mitigado pela retenção (SEC-014)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/routers/auth_router.py"
                },
                "region": {
                  "startLine": 58
                }
              }
            }
          ],
          "properties": {
            "source": [
              "claude"
            ]
          }
        },
        {
          "ruleId": "SEC-020",
          "level": "note",
          "message": {
            "text": "Filtros de data inválidos em /logs são ignorados em silêncio. Sem ganho de acesso (só admin/gestor); pode levar a conclusões erradas numa investigação."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/routers/dashboard.py"
                },
                "region": {
                  "startLine": 98
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/routers/dashboard.py"
                },
                "region": {
                  "startLine": 104
                }
              }
            }
          ],
          "properties": {
            "source": [
              "bandit",
              "claude"
            ]
          }
        }
      ]
    }
  ]
}