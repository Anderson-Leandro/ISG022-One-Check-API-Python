# Copie para .env e preencha. O .env não é versionado.
# Variáveis comentadas usam o padrão indicado.

# Sem valor, vale a regra de produção (a API não sobe sem JWT_SECRET forte).
# Para rodar localmente sem Docker, use APP_ENV=development: o JWT_SECRET pode ficar
# vazio e o start.sh cria as contas de demonstração (credenciais públicas, só para dev).
APP_ENV=

# Obrigatório fora de desenvolvimento, 32+ caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Docker Compose: obrigatório. Gere com o mesmo comando acima
POSTGRES_PASSWORD=
# POSTGRES_USER=onecheck
# POSTGRES_DB=onecheck
# Porta do Postgres no host (só em 127.0.0.1) e da API
# POSTGRES_PORT=5432
# API_PORT=8000

# Sem Docker: banco da API (padrão: SQLite onecheck.db na raiz)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/onecheck

# Origens do front, separadas por vírgula (ex.: https://onecheck-web.onrender.com).
# Vazio: em produção nenhum navegador em outra origem chama a API; em desenvolvimento, todas
CORS_ORIGINS=
# URL pública da API, usada nos links das fotos
# PUBLIC_BASE_URL=http://localhost:8000
# /docs, /redoc e /openapi.json: vazio = ligado só em desenvolvimento
# DOCS_ENABLED=false

# Vazio = rotas /admin/* desabilitadas. Com valor, 32+ caracteres fora de desenvolvimento
SEED_SECRET=
# Necessário para /admin/seed com force=true e para /admin/refresh-data (apagam dados)
# SEED_ALLOW_DESTRUCTIVE=false

# Validade dos tokens
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=30
# Limite de tentativas falhas de login/MFA/reautenticação
# RATE_LIMIT_FALHAS_CONTA=5
# RATE_LIMIT_FALHAS_IP=20
# RATE_LIMIT_JANELA_MIN=15
# Tamanho máximo do corpo: uploads (MB) e demais requisições, como JSON (KB)
# MAX_UPLOAD_MB=10
# MAX_BODY_KB=1024
# Dias de log_operacao guardados (mínimo 180, registros de acesso do Marco Civil)
# LOG_RETENCAO_DIAS=365
